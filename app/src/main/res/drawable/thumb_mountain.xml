<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="160dp"
    android:height="100dp"
    android:viewportWidth="160"
    android:viewportHeight="100">

    <!-- Sky Background -->
    <path
        android:fillColor="#0D1117"
        android:pathData="M0,0 H160 V100 H0 Z" />

    <!-- Distant Sun / Glow -->
    <path
        android:fillColor="#FF8F00"
        android:pathData="M95,38 A14,14 0 1,0 95,10 A14,14 0 1,0 95,38 Z" />

    <path
        android:fillColor="#FFA000"
        android:pathData="M95,34 A10,10 0 1,0 95,14 A10,10 0 1,0 95,34 Z" />

    <!-- Distant Mountain (Deep Blue Gray) -->
    <path
        android:fillColor="#1F2937"
        android:pathData="M0,100 L30,55 L65,75 L110,35 L145,70 L160,52 L160,100 Z" />

    <!-- Mid Mountain Layer -->
    <path
        android:fillColor="#111827"
        android:pathData="M0,100 L20,72 L50,48 L85,82 L125,50 L160,85 L160,100 Z" />

    <!-- Front Mountain Peak & Hills -->
    <path
        android:fillColor="#030712"
        android:pathData="M0,100 L35,80 L70,62 L100,88 L140,68 L160,78 L160,100 Z" />

    <!-- Grid / Horizon Subtle Lines -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2563EB"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4"
        android:pathData="M0,90 Q80,82 160,90" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1"
        android:strokeAlpha="0.3"
        android:pathData="M0,96 Q80,90 160,96" />
</vector>
